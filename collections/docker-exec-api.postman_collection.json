        {
          "id": "ba17dca0-3859-43bd-966b-2ab7e3fa2b4a",
          "name": "Start an exec instance",
          "request": {
            "name": "Start an exec instance",
            "description": {
              "content": "Starts a previously set up exec instance. If detach is true, this endpoint\nreturns immediately after starting the command. Otherwise, it sets up an\ninteractive session with the command.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "exec",
                ":id",
                "start"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) Exec instance ID"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/vnd.docker.raw-stream"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Detach\": \"<boolean>\",\n  \"Tty\": \"<boolean>\",\n  \"ConsoleSize\": [\n    \"<integer>\",\n    \"<integer>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
